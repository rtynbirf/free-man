{
  "manifest_version": 3,
  "name": "FREE MAN — Browser Autonomy",
  "short_name": "FREE MAN",
  "version": "0.2.1",
  "minimum_chrome_version": "111",
  "description": "Local-first: 72 tracker domains blocked, per-site pause, per-tab counter, site-data wipe, 7-day self-defense guide. No account, cloud, or telemetry.",
  "permissions": ["storage", "declarativeNetRequest", "declarativeNetRequestFeedback", "activeTab", "alarms", "browsingData", "clipboardWrite"],
  "optional_host_permissions": ["<all_urls>"],
  "action": { "default_title": "FREE MAN", "default_popup": "popup.html" },
  "options_page": "guide.html",
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "declarative_net_request": {
    "rule_resources": [
      { "id": "trackers", "enabled": true,  "path": "rules/trackers.json" },
      { "id": "ads",      "enabled": false, "path": "rules/ads.json" },
      { "id": "widgets",  "enabled": false, "path": "rules/widgets.json" }
    ]
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
